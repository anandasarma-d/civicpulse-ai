{
  "name": "civicpulse-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "dev:frontend": "vite --port=3000 --host=0.0.0.0",
    "dev:backend": "tsx backend/server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "validate:data": "tsx scripts/validateDataIntegrity.ts",
    "test:integrity": "tsx tests/unit/dataIntegrity.test.ts",
    "test:understanding": "tsx tests/unit/requestUnderstanding.test.ts",
    "test:integration": "tsx tests/integration/requestsEndpoints.test.ts",
    "test:eval": "tsx tests/unit/aiEvaluation.test.ts",
    "test:rice05": "tsx tests/integration/rice05Multimodal.test.ts",
    "test:clustering": "tsx tests/unit/clustering.test.ts",
    "test:clusters-api": "tsx tests/integration/clustersEndpoints.test.ts",
    "test:clustering-eval": "tsx tests/ai_eval/clusteringEvaluation.ts",
    "test": "tsx tests/unit/dataIntegrity.test.ts && tsx tests/unit/requestUnderstanding.test.ts && tsx tests/integration/requestsEndpoints.test.ts && tsx tests/unit/aiEvaluation.test.ts && tsx tests/integration/rice05Multimodal.test.ts && tsx tests/unit/clustering.test.ts && tsx tests/integration/clustersEndpoints.test.ts && tsx tests/ai_eval/clusteringEvaluation.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "supertest": "^7.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
